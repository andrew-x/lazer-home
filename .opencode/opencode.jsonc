{
  "$schema": "https://opencode.ai/config.json",

  "instructions": [
    "src/AGENTS.md",
    "src/actions/AGENTS.md",
    "src/lib/db/AGENTS.md"
  ],

  "permission": {
    "bash": {
      "*": "ask",

      "bun run *": "allow",
      "bun test*": "allow",
      "bunx biome *": "allow",
      "bunx --bun biome *": "allow",
      "bunx drizzle-kit *": "allow",
      "bunx --bun shadcn *": "allow",
      "biome *": "allow",
      "tsc*": "allow",

      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git show*": "allow",

      "ls*": "allow",
      "find *": "allow",
      "grep *": "allow",
      "rg *": "allow",
      "cat *": "allow",

      "cat /*": "ask",
      "cat ~/*": "ask",
      "ls /*": "ask",
      "ls ~/*": "ask",
      "find /*": "ask",
      "find ~/*": "ask"
    },
    "external_directory": {
      "*": "ask"
    }
  },
  "formatter": {
    "prettier": {
      "disabled": true
    }
  },
  "provider": {
    "lazer-proxy": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Lazer AI Proxy",
      "options": {
        "baseURL": "https://proxy.lazertechnologies.com/v1"
      },
      "models": {
        "deepseek-v4-flash": {
          "name": "deepseek-v4-flash",
          "attachment": false,
          "reasoning": true,
          "temperature": true,
          "tool_call": true,
          "limit": {
            "context": 1048576,
            "output": 65536
          },
          "family": "deepseek",
          "release_date": "2026-04-24",
          "cost": {
            "input": 0.1,
            "output": 0.2,
            "cache_read": 0.02
          },
          "modalities": {
            "input": ["text"],
            "output": ["text"]
          },
          "interleaved": {
            "field": "reasoning_content"
          }
        },
        "deepseek-v4-pro": {
